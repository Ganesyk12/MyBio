<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="Admin Panel Forgot Password" />
    <link rel="icon" href="/img/logo.webp" type="image/webp">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        .login-brand {
            display: none;
            flex: 1;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 60px;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .login-brand::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%);
        }

        .login-brand .brand-content {
            position: relative;
            z-index: 1;
        }

        .login-brand .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 80px;
        }

        .login-brand .brand-logo .logo-icon {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #fff;
        }

        .login-brand .brand-logo span {
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .login-brand h1 {
            color: #fff;
            font-size: 2.2rem;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 16px;
        }

        .login-brand p {
            color: rgba(255,255,255,0.6);
            font-size: 1rem;
            line-height: 1.6;
            max-width: 400px;
        }

        .login-brand .brand-footer {
            color: rgba(255,255,255,0.35);
            font-size: 0.8rem;
            position: relative;
            z-index: 1;
        }

        .login-form-section {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: #f0f2f5;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
        }

        .login-card .card-header {
            margin-bottom: 32px;
        }

        .login-card .card-header h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #101828;
            margin-bottom: 6px;
        }

        .login-card .card-header p {
            font-size: 0.9rem;
            color: #667085;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            color: #344054;
            margin-bottom: 6px;
        }

        .form-group .input-wrapper {
            position: relative;
        }

        .form-group .input-wrapper .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #98a2b3;
            font-size: 16px;
            pointer-events: none;
        }

        .form-group .form-control {
            width: 100%;
            padding: 10px 12px 10px 38px;
            border: 1px solid #d0d5dd;
            border-radius: 8px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            color: #101828;
            background: #fff;
            transition: all 0.15s ease;
            outline: none;
        }

        .form-group .form-control::placeholder {
            color: #98a2b3;
        }

        .form-group .form-control:focus {
            border-color: #4a6cf7;
            box-shadow: 0 0 0 3px rgba(74,108,247,0.12);
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-bottom: 24px;
        }

        .form-options .forgot-link {
            font-size: 0.85rem;
            color: #4a6cf7;
            text-decoration: none;
            font-weight: 500;
        }

        .form-options .forgot-link:hover {
            text-decoration: underline;
        }

        .btn-primary {
            width: 100%;
            padding: 10px;
            background: #4a6cf7;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .btn-primary:hover {
            background: #3b5de7;
        }

        .btn-primary:active {
            background: #2f4fd9;
        }

        .alert-danger {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: #fef3f2;
            border: 1px solid #fecdca;
            border-radius: 8px;
            color: #b42318;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        .alert-success {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: #ecfdf3;
            border: 1px solid #abefc6;
            border-radius: 8px;
            color: #067647;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        .collapse-section {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #eaecf0;
        }

        .collapse-section .section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #344054;
            margin-bottom: 4px;
        }

        .collapse-section .section-subtitle {
            font-size: 0.8rem;
            color: #667085;
            margin-bottom: 16px;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            color: #98a2b3;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.15s ease;
        }

        .password-toggle:hover {
            color: #475467;
        }

        .password-toggle .eye-hide {
            display: none;
        }

        .password-toggle.show .eye-show {
            display: none;
        }

        .password-toggle.show .eye-hide {
            display: block;
        }

        .password-field {
            padding-right: 40px !important;
        }

        .hidden-section {
            display: none;
        }

        @media (min-width: 900px) {
            .login-brand {
                display: flex;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-brand">
            <div class="brand-content">
                <div class="brand-logo">
                    <div class="logo-icon">M</div>
                    <span>MyBio</span>
                </div>
                <h1>Reset your<br>password</h1>
                <p>Verify your username and set a brand new password to get back into your dashboard.</p>
            </div>
            <div class="brand-footer">&copy; 2026 MyBio. All rights reserved.</div>
        </div>

        <div class="login-form-section">
            <div class="login-card">
                <div class="card-header">
                    <h2>Forgot password</h2>
                    <p>Enter your username to reset your password.</p>
                </div>

                <% if (error) { %>
                    <div class="alert-danger">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1C4.136 1 1 4.136 1 8s3.136 7 7 7 7-3.136 7-7-3.136-7-7-7zm0 12.5A5.506 5.506 0 012.5 8c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5zm.5-8.5h-1v4h1V5zm0 5h-1v1h1v-1z" fill="#b42318"/></svg>
                        <%= error %>
                    </div>
                <% } %>

                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert-success">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1C4.136 1 1 4.136 1 8s3.136 7 7 7 7-3.136 7-7-3.136-7-7-7zm0 12.5A5.506 5.506 0 012.5 8c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5zm2.854-8.354L7.5 9.293 5.854 7.646l-.708.708 2 2 .708-.708 3.5-3.5-.708-.708z" fill="#067647"/></svg>
                        <%= success %>
                    </div>
                <% } %>

                <!-- Step 1: Validate Username -->
                <form action="/forgot-password" method="POST">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 8a3 3 0 100-6 3 3 0 000 6zm0-4.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 6c-3.315 0-6 1.342-6 3v1.5h12V12.5c0-1.658-2.685-3-6-3z" fill="currentColor"/></svg>
                            </span>
                            <input type="text" id="username" name="username" class="form-control" placeholder="Enter your username" value="<%= username || '' %>" required autofocus>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary">Verify username</button>
                </form>

                <!-- Step 2: Reset Password (shown if username is valid) -->
                <% if (typeof step !== 'undefined' && step === 2) { %>
                    <div class="collapse-section">
                        <div class="section-title">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm4-3.5h-.5V4a3.5 3.5 0 00-7 0v2H4a1 1 0 00-1 1v5a1 1 0 001 1h8a1 1 0 001-1V7a1 1 0 00-1-1zm-6-2a2 2 0 014 0v2H6V4z" fill="#4a6cf7"/></svg>
                            Set new password for <strong style="margin-left:4px"><%= username %></strong>
                        </div>
                        <div class="section-subtitle">Choose a new password for your account.</div>

                        <form action="/reset-password" method="POST">
                            <input type="hidden" name="username" value="<%= username %>">
                            <div class="form-group">
                                <label for="password">New Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm4-3.5h-.5V4a3.5 3.5 0 00-7 0v2H4a1 1 0 00-1 1v5a1 1 0 001 1h8a1 1 0 001-1V7a1 1 0 00-1-1zm-6-2a2 2 0 014 0v2H6V4z" fill="currentColor"/></svg>
                                    </span>
                                    <input type="password" id="password" name="password" class="form-control password-field" placeholder="Enter new password" required>
                                    <button type="button" class="password-toggle" onclick="togglePassword()" aria-label="Toggle password visibility">
                                        <svg class="eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="currentColor"/></svg>
                                        <svg class="eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M2 2l20 20M10.41 10.41a2 2 0 002.83 2.83M15.54 15.54a5.06 5.06 0 01-7.08 0C5.2 12.28 3 9.6 3 9.6a15.52 15.52 0 013.23-2.9M12 17a7.13 7.13 0 01-4.47-1.6M6.6 6.6A15.58 15.58 0 0012 6.1C16.8 5.6 21 9.6 21 9.6a15.52 15.52 0 01-3.23 4.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="confirmPassword">Confirm New Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm4-3.5h-.5V4a3.5 3.5 0 00-7 0v2H4a1 1 0 00-1 1v5a1 1 0 001 1h8a1 1 0 001-1V7a1 1 0 00-1-1zm-6-2a2 2 0 014 0v2H6V4z" fill="currentColor"/></svg>
                                    </span>
                                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control password-field" placeholder="Repeat new password" required>
                                    <button type="button" class="password-toggle" onclick="togglePassword()" aria-label="Toggle password visibility">
                                        <svg class="eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="currentColor"/></svg>
                                        <svg class="eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M2 2l20 20M10.41 10.41a2 2 0 002.83 2.83M15.54 15.54a5.06 5.06 0 01-7.08 0C5.2 12.28 3 9.6 3 9.6a15.52 15.52 0 013.23-2.9M12 17a7.13 7.13 0 01-4.47-1.6M6.6 6.6A15.58 15.58 0 0012 6.1C16.8 5.6 21 9.6 21 9.6a15.52 15.52 0 01-3.23 4.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="btn-primary">Reset password</button>
                        </form>
                    </div>
                <% } %>

                <div style="text-align:center;margin-top:16px">
                    <a href="/login" style="display:inline-block;width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:8px;font-size:0.9rem;font-weight:500;font-family:'Inter',sans-serif;color:#475467;background:#fff;text-decoration:none;box-sizing:border-box;transition:all 0.15s" onmouseover="this.style.borderColor='#4a6cf7';this.style.color='#4a6cf7'" onmouseout="this.style.borderColor='#d0d5dd';this.style.color='#475467'">Back to login</a>
                </div>

            </div>
        </div>
    </div>
    <script>
        function togglePassword() {
            const inputs = [document.getElementById('password'), document.getElementById('confirmPassword')];
            const show = inputs[0].type === 'password';
            inputs.forEach(function (input) {
                if (input) {
                    input.type = show ? 'text' : 'password';
                }
            });
            document.querySelectorAll('.password-toggle').forEach(function (btn) {
                btn.classList.toggle('show', show);
            });
        }
    </script>
</body>
</html>
