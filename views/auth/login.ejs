<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="Admin Panel Login" />
    <link rel="icon" href="/img/logo.webp" type="image/webp">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        .login-brand {
            display: none;
            flex: 1;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 60px;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .login-brand::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%);
        }

        .login-brand .brand-content {
            position: relative;
            z-index: 1;
        }

        .login-brand .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 80px;
        }

        .login-brand .brand-logo .logo-icon {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #fff;
        }

        .login-brand .brand-logo span {
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .login-brand h1 {
            color: #fff;
            font-size: 2.2rem;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 16px;
        }

        .login-brand p {
            color: rgba(255,255,255,0.6);
            font-size: 1rem;
            line-height: 1.6;
            max-width: 400px;
        }

        .login-brand .brand-footer {
            color: rgba(255,255,255,0.35);
            font-size: 0.8rem;
            position: relative;
            z-index: 1;
        }

        .login-form-section {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: #f0f2f5;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
        }

        .login-card .card-header {
            margin-bottom: 32px;
        }

        .login-card .card-header h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #101828;
            margin-bottom: 6px;
        }

        .login-card .card-header p {
            font-size: 0.9rem;
            color: #667085;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            color: #344054;
            margin-bottom: 6px;
        }

        .form-group .input-wrapper {
            position: relative;
        }

        .form-group .input-wrapper .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #98a2b3;
            font-size: 16px;
            pointer-events: none;
        }

        .form-group .form-control {
            width: 100%;
            padding: 10px 12px 10px 38px;
            border: 1px solid #d0d5dd;
            border-radius: 8px;
            font-size: 0.9rem;
            font-family: 'Inter', sans-serif;
            color: #101828;
            background: #fff;
            transition: all 0.15s ease;
            outline: none;
        }

        .form-group .form-control::placeholder {
            color: #98a2b3;
        }

        .form-group .form-control:focus {
            border-color: #4a6cf7;
            box-shadow: 0 0 0 3px rgba(74,108,247,0.12);
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-bottom: 24px;
        }

        .form-options .forgot-link {
            font-size: 0.85rem;
            color: #4a6cf7;
            text-decoration: none;
            font-weight: 500;
        }

        .form-options .forgot-link:hover {
            text-decoration: underline;
        }

        .btn-primary {
            width: 100%;
            padding: 10px;
            background: #4a6cf7;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .btn-primary:hover {
            background: #3b5de7;
        }

        .btn-primary:active {
            background: #2f4fd9;
        }

        .alert-danger {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: #fef3f2;
            border: 1px solid #fecdca;
            border-radius: 8px;
            color: #b42318;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        .alert-success {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: #ecfdf3;
            border: 1px solid #abefc6;
            border-radius: 8px;
            color: #067647;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        @media (min-width: 900px) {
            .login-brand {
                display: flex;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-brand">
            <div class="brand-content">
                <div class="brand-logo">
                    <div class="logo-icon">M</div>
                    <span>MyBio</span>
                </div>
                <h1>Welcome back<br>to your dashboard</h1>
                <p>Monitor your projects, manage content, and track performance all in one place.</p>
            </div>
            <div class="brand-footer">&copy; 2026 MyBio. All rights reserved.</div>
        </div>

        <div class="login-form-section">
            <div class="login-card">
                <div class="card-header">
                    <h2>Sign in</h2>
                    <p>Enter your credentials to access the admin panel.</p>
                </div>

                <% if (error) { %>
                    <div class="alert-danger">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1C4.136 1 1 4.136 1 8s3.136 7 7 7 7-3.136 7-7-3.136-7-7-7zm0 12.5A5.506 5.506 0 012.5 8c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5zm.5-8.5h-1v4h1V5zm0 5h-1v1h1v-1z" fill="#b42318"/></svg>
                        <%= error %>
                    </div>
                <% } %>

                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert-success">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1C4.136 1 1 4.136 1 8s3.136 7 7 7 7-3.136 7-7-3.136-7-7-7zm0 12.5A5.506 5.506 0 012.5 8c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5zm2.854-8.354L7.5 9.293 5.854 7.646l-.708.708 2 2 .708-.708 3.5-3.5-.708-.708z" fill="#067647"/></svg>
                        <%= success %>
                    </div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 8a3 3 0 100-6 3 3 0 000 6zm0-4.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 6c-3.315 0-6 1.342-6 3v1.5h12V12.5c0-1.658-2.685-3-6-3z" fill="currentColor"/></svg>
                            </span>
                            <input type="text" id="username" name="username" class="form-control" placeholder="Enter your username" required autofocus>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm4-3.5h-.5V4a3.5 3.5 0 00-7 0v2H4a1 1 0 00-1 1v5a1 1 0 001 1h8a1 1 0 001-1V7a1 1 0 00-1-1zm-6-2a2 2 0 014 0v2H6V4z" fill="currentColor"/></svg>
                            </span>
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
                        </div>
                    </div>
                    <div class="form-options">
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>
                    <button type="submit" class="btn-primary">Sign in</button>
                </form>

                <div style="text-align:center;margin-top:16px">
                    <a href="/" style="display:inline-block;width:100%;padding:10px;border:1px solid #d0d5dd;border-radius:8px;font-size:0.9rem;font-weight:500;font-family:'Inter',sans-serif;color:#475467;background:#fff;text-decoration:none;box-sizing:border-box;transition:all 0.15s" onmouseover="this.style.borderColor='#4a6cf7';this.style.color='#4a6cf7'" onmouseout="this.style.borderColor='#d0d5dd';this.style.color='#475467'">Back to homepage</a>
                </div>

            </div>
        </div>
    </div>
</body>
</html>