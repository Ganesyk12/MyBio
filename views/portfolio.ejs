<section id="portfolio" class="portfolio section">
    <div class="container section-title" data-aos="fade-down">
        <h2>Portfolio</h2>
        <div class="title-shape">
            <svg viewBox="0 0 200 20" xmlns="http://www.w3.org/2000/svg">
                <path d="M 0,10 C 40,0 60,20 100,10 C 140,0 160,20 200,10" fill="none" stroke="currentColor"
                    stroke-width="2"></path>
            </svg>
        </div>
    </div>
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="portfolio-slider-layout">
            <!-- Filter -->
            <div class="portfolio-filters-container" data-aos="fade-up" data-aos-delay="200">
                <ul class="portfolio-filters">
                    <li class="filter-active" data-filter="*">All Work</li>
                    <% type.forEach(item=> { %>
                        <li data-filter=".filter-<%= item.IdType %>">
                            <%= item.TypeName %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            
            <!-- Slider Wrapper -->
            <div class="portfolio-slider-container" data-aos="fade-up" data-aos-delay="300">
                <!-- Swiper -->
                <div class="swiper portfolio-swiper">
                    <div class="swiper-wrapper">
                        <% project.forEach((p, index)=> { %>
                            <div class="swiper-slide portfolio-slide-item" data-type="<%= p.IdType %>">
                                <a href="/portfolio/<%= p.IdProject %>" class="portfolio-card-link">
                                    <div class="portfolio-card">
                                        <div class="portfolio-image">
                                            <img src="<%= p.FilePath || '/img/nothing.png' %>" class="img-fluid" alt="<%= p.ProjectName %>" loading="lazy" onerror="this.onerror=null; this.src='/img/nothing.png';">
                                        </div>
                                        <div class="portfolio-content">
                                            <span class="category"><%= p.TypeName %></span>
                                            <h3><%= p.ProjectName %></h3>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                    </div>
                    
                    <!-- Pagination -->
                    <div class="swiper-pagination"></div>
                </div>
                
                <!-- Navigation -->
                <button class="slider-btn slider-prev" aria-label="Previous Slide">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="slider-btn slider-next" aria-label="Next Slide">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</section>