<section class="section" style="min-height:60vh;display:flex;align-items:center">
    <div class="container text-center" data-aos="fade-up">
        <h1 style="font-size:6rem;font-weight:800;color:var(--accent-color, #2c3e50);margin-bottom:0;line-height:1">404</h1>
        <div class="title-shape" style="justify-content:center;margin:10px 0 20px">
            <svg viewBox="0 0 200 20" xmlns="http://www.w3.org/2000/svg" style="width:120px">
                <path d="M 0,10 C 40,0 60,20 100,10 C 140,0 160,20 200,10" fill="none" stroke="currentColor" stroke-width="2"></path>
            </svg>
        </div>
        <p style="font-size:1.2rem;color:#6c757d;margin-bottom:30px"><%= typeof message !== 'undefined' ? message : 'Page not found' %></p>
        <a href="/" class="btn btn-primary" style="padding:12px 32px;border-radius:30px">Back to Home</a>
    </div>
</section>