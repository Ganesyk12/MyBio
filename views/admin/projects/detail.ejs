<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Project Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/centralize"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="/centralize/projects">Projects</a></li>
                    <li class="breadcrumb-item"><a href="#!">Project Detail</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <h5>Project Details - Read Only</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th class="pl-0" style="width: 30%;">ID Project</th>
                                    <td>: <%= project.IdProject %></td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Project Name</th>
                                    <td>: <%= project.ProjectName %></td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Project Type</th>
                                    <td>
                                        : <label class="badge badge-light-primary"><%= project.ProjectType ? project.ProjectType.TypeName : 'N/A' %></label>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Status</th>
                                    <td>
                                        : 
                                        <% if (project.Status === 'N') { %>
                                            <label class="badge badge-light-danger">Inactive (Soft Deleted)</label>
                                        <% } else { %>
                                            <label class="badge badge-light-success">Active</label>
                                        <% } %>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Date Created</th>
                                    <td>: <%= new Date(project.DateCreated).toLocaleString('id-ID') %></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <% const mainImage = project.ProjectDetail && project.ProjectDetail.length > 0 ? project.ProjectDetail[0].FilePath : null; %>
                    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
                        <div class="border rounded p-3 bg-light text-center" style="max-width: 320px; width: 100%;">
                            <h6 class="text-muted mb-2 font-weight-bold">Media Preview</h6>
                            <a href="<%= mainImage || '/img/nothing.png' %>" target="_blank">
                                <img src="<%= mainImage || '/img/nothing.png' %>" alt="<%= project.ProjectName %>" class="img-fluid rounded shadow-sm" style="max-height: 180px; width: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/img/nothing.png';">
                            </a>
                            <% if (mainImage) { %>
                                <div class="mt-2">
                                    <a href="<%= mainImage %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="feather icon-external-link mr-1"></i> Open Original Media
                                    </a>
                                </div>
                            <% } else { %>
                                <span class="badge badge-light-secondary mt-2">Default (No Media)</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <hr>

                <h5 class="mt-4 mb-3">Project Details (Sub Entries)</h5>

                <% if(project.ProjectDetail && project.ProjectDetail.length > 0) { %>
                    <div class="table-responsive mt-3">
                        <table class="table table-bordered">
                            <thead class="thead-light">
                                <tr>
                                    <th>No</th>
                                    <th>Media Preview</th>
                                    <th>Description</th>
                                    <th>File Path / URL</th>
                                    <th>Link</th>
                                    <th>Related Skill</th>
                                    <th>Date Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% project.ProjectDetail.forEach((detail, idx) => { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td class="text-center" style="width: 100px;">
                                            <a href="<%= detail.FilePath || '/img/nothing.png' %>" target="_blank">
                                                <img src="<%= detail.FilePath || '/img/nothing.png' %>" alt="Preview" class="img-thumbnail" style="max-height: 60px; object-fit: cover;" onerror="this.onerror=null; this.src='/img/nothing.png';">
                                            </a>
                                        </td>
                                        <td><%= detail.Description || '-' %></td>
                                        <td style="max-width: 220px; word-break: break-all;">
                                            <% if(detail.FilePath) { %>
                                                <a href="<%= detail.FilePath %>" target="_blank" class="text-primary"><%= detail.FilePath %></a>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if(detail.Link) { %>
                                                <a href="<%= detail.Link %>" target="_blank" class="text-info"><%= detail.Link %></a>
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if(detail.Skill) { %>
                                                <label class="badge badge-light-info"><%= detail.Skill.SkillName %></label>
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                        <td><%= new Date(detail.DateCreated).toLocaleString('id-ID') %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="alert alert-warning" role="alert">
                        This project currently has no details appended.
                    </div>
                <% } %>

                <div class="row mt-4">
                    <div class="col-sm-10">
                        <a href="/centralize/projects" class="btn btn-secondary">
                            <i class="feather icon-arrow-left"></i> Back to Projects
                        </a>
                        <a href="/centralize/projects/edit/<%= project.IdProject %>" class="btn btn-info">
                            <i class="feather icon-edit"></i> Edit Project
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
