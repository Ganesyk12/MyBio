<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Project Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/centralize"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="/centralize/projects">Projects</a></li>
                    <li class="breadcrumb-item"><a href="#!">Project Detail</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <h5>Project Details - Read Only</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th class="pl-0" style="width: 30%;">ID Project</th>
                                    <td>: <%= project.IdProject %></td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Project Name</th>
                                    <td>: <%= project.ProjectName %></td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Project Type</th>
                                    <td>
                                        : <label class="badge badge-light-primary"><%= project.ProjectType ? project.ProjectType.TypeName : 'N/A' %></label>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Status</th>
                                    <td>
                                        : 
                                        <% if (project.Status === 'N') { %>
                                            <label class="badge badge-light-danger">Inactive (Soft Deleted)</label>
                                        <% } else { %>
                                            <label class="badge badge-light-success">Active</label>
                                        <% } %>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="pl-0">Date Created</th>
                                    <td>: <%= new Date(project.DateCreated).toLocaleString('id-ID') %></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <% const mainImage = project.ProjectDetail && project.ProjectDetail.length > 0 ? project.ProjectDetail[0].FilePath : null; %>
                    <div class="col-md-6 d-flex flex-column align-items-center justify-content-center">
                        <div class="border rounded p-3 bg-light text-center" style="max-width: 320px; width: 100%;">
                            <h6 class="text-muted mb-2 font-weight-bold">Media Preview</h6>
                            <a href="<%= mainImage || '/img/nothing.png' %>" target="_blank">
                                <img src="<%= mainImage || '/img/nothing.png' %>" alt="<%= project.ProjectName %>" class="img-fluid rounded shadow-sm" style="max-height: 180px; width: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/img/nothing.png';">
                            </a>
                            <% if (mainImage) { %>
                                <div class="mt-2">
                                    <a href="<%= mainImage %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="feather icon-external-link mr-1"></i> Open Original Media
                                    </a>
                                </div>
                            <% } else { %>
                                <span class="badge badge-light-secondary mt-2">Default (No Media)</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="d-flex align-items-center justify-content-between mt-4 mb-3">
                    <h5 class="mb-0">Project Details (Sub Entries)</h5>
                    <span class="badge badge-light-primary font-weight-bold"><%= project.ProjectDetail ? project.ProjectDetail.length : 0 %> Sub Entries</span>
                </div>

                <% if(project.ProjectDetail && project.ProjectDetail.length > 0) { %>
                    <div class="row">
                        <% project.ProjectDetail.forEach((detail, idx) => { %>
                            <div class="col-12 mb-3">
                                <div class="card border shadow-none mb-0" style="background-color: #fafbfc; border-radius: 8px;">
                                    <div class="card-header py-2 px-3 bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap">
                                        <div class="d-flex align-items-center mb-1 mb-sm-0">
                                            <span class="badge badge-light-secondary font-weight-bold mr-2">#<%= idx + 1 %></span>
                                            <h6 class="mb-0 font-weight-bold text-dark mr-3">Sub Entry #<%= idx + 1 %></h6>
                                            <% if(detail.Skill) { %>
                                                <span class="badge badge-light-info font-weight-semibold">
                                                    <i class="feather icon-check-circle mr-1"></i><%= detail.Skill.SkillName %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <small class="text-muted">
                                            <i class="feather icon-clock mr-1"></i><%= new Date(detail.DateCreated).toLocaleString('id-ID') %>
                                        </small>
                                    </div>
                                    <div class="card-body p-3">
                                        <!-- Description -->
                                        <div class="mb-3">
                                            <label class="text-muted font-weight-bold small mb-1">DESCRIPTION</label>
                                            <p class="text-dark mb-0 bg-white p-3 rounded border" style="white-space: pre-line; line-height: 1.5; font-size: 13.5px;">
                                                <%= detail.Description || '-' %>
                                            </p>
                                        </div>

                                        <!-- External Link -->
                                        <div>
                                            <label class="text-muted font-weight-bold small mb-1">EXTERNAL PROJECT LINK</label>
                                            <div class="bg-white border rounded p-2 d-flex align-items-center">
                                                <i class="feather icon-link text-muted mr-2" style="font-size: 14px;"></i>
                                                <div style="min-width: 0; flex: 1;">
                                                    <% if(detail.Link) { %>
                                                        <a href="<%= detail.Link %>" target="_blank" class="text-primary text-break font-weight-medium d-inline-block" style="font-size: 13px; word-break: break-all;">
                                                            <%= detail.Link %> <i class="feather icon-external-link ml-1" style="font-size: 11px;"></i>
                                                        </a>
                                                    <% } else { %>
                                                        <span class="text-muted font-italic" style="font-size: 12.5px;">No link provided</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="alert alert-warning" role="alert">
                        This project currently has no details appended.
                    </div>
                <% } %>

                <div class="row mt-4">
                    <div class="col-sm-10">
                        <a href="/centralize/projects" class="btn btn-secondary">
                            <i class="feather icon-arrow-left"></i> Back to Projects
                        </a>
                        <a href="/centralize/projects/edit/<%= project.IdProject %>" class="btn btn-info">
                            <i class="feather icon-edit"></i> Edit Project
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
